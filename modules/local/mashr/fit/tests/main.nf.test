nextflow_process {

    name "Test Process MASHR_FIT"
    script "../main.nf"
    process "MASHR_FIT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "mashr"
    tag "mashr/fit"

    test("mashr_mini - stub") {
        options "-stub"

        tag "stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'mashr_mini' ],
                    file("${projectDir}/assets/testdata/mashr_mini/effects.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.mash.size() == 1 },
                { assert path(process.out.outdir.get(0).get(1)).exists() }
            )
        }
    }
}
