nextflow_process {

    name "Test Process SMR_HEIDI"
    script "../main.nf"
    process "SMR_HEIDI"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "smr"
    tag "smr/heidi"

    test("coloc_mini - stub") {
        options "-stub"

        tag "stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'smr_mini' ],
                    file("${projectDir}/assets/testdata/coloc_mini/qtl.tsv", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'smr_mini' ],
                    file("${projectDir}/assets/testdata/coloc_mini/gwas.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.smr.size() == 1 },
                { assert path(process.out.outdir.get(0).get(1)).exists() }
            )
        }
    }
}
