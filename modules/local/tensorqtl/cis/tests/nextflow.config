process {
    withName: 'TENSORQTL_CIS' {
        // Stub / default smoke
        ext.args = '--mode cis'
    }
}

env {
    KMP_DUPLICATE_LIB_OK = 'TRUE'
}

profiles {
    // Real GEUVADIS smoke: cis_nominal avoids long permutation runs on CPU
    conda {
        process {
            withName: 'TENSORQTL_CIS' {
                ext.args = '--mode cis_nominal'
            }
        }
    }
}
