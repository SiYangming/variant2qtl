nextflow_process {

    name "Test Process OMIGA_CIS"
    script "../main.nf"
    process "OMIGA_CIS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "omiga"
    tag "omiga/cis"

    test("homo_sapiens popgen - omiga_cis_mini") {
        tag "gwas_real"
        tag "omiga_cis_real"

        when {
            process {
                """
                input[0] = [
                    [ id:'omiga_cis_mini' ],
                    file("${projectDir}/assets/testdata/omiga_cis_mini/geno.bed", checkIfExists: true),
                    file("${projectDir}/assets/testdata/omiga_cis_mini/geno.bim", checkIfExists: true),
                    file("${projectDir}/assets/testdata/omiga_cis_mini/geno.fam", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'omiga_cis_mini' ],
                    file("${projectDir}/assets/testdata/omiga_cis_mini/phenotype.bed.gz", checkIfExists: true)
                ]
                input[2] = [
                    [ id:'omiga_cis_mini' ],
                    file("${projectDir}/assets/testdata/omiga_cis_mini/covariates.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.outdir.size() == 1 },
                { assert process.out.outdir.get(0).get(0).id == "omiga_cis_mini" },
                { assert path(process.out.outdir.get(0).get(1)).exists() },
                { assert process.out.cis_qtl },
                {
                    def cis = process.out.cis_qtl.get(0).get(1)
                    def files = cis instanceof List ? cis : [cis]
                    assert files.every { f -> path(f.toString()).exists() }
                    assert files.any { f -> path(f.toString()).size() > 0 }
                }
            )
        }
    }
}
