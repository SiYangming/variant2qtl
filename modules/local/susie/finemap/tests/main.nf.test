nextflow_process {

    name "Test Process SUSIE_FINEMAP"
    script "../main.nf"
    process "SUSIE_FINEMAP"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "susie"
    tag "susie/finemap"

    test("finemap_susie_mini - stub") {
        options "-stub"

        tag "stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'finemap_susie_mini' ],
                    file("${projectDir}/assets/testdata/finemap_susie_mini/sumstats.tsv", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'finemap_susie_mini' ],
                    file("${projectDir}/assets/testdata/finemap_susie_mini/ld.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.pip.size() == 1 },
                { assert process.out.credible_sets.size() == 1 },
                { assert path(process.out.outdir.get(0).get(1)).exists() }
            )
        }
    }
}
