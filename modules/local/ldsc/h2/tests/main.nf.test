nextflow_process {

    name "Test Process LDSC_H2"
    script "../main.nf"
    process "LDSC_H2"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "ldsc"
    tag "ldsc/h2"

    test("ldsc_mini - stub") {
        options "-stub"

        tag "stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'ldsc_mini' ],
                    file("${projectDir}/assets/testdata/ldsc_mini/sumstats.tsv", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'ldsc_mini' ],
                    file("${projectDir}/assets/testdata/ldsc_mini/annot.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.h2.size() == 1 },
                { assert path(process.out.outdir.get(0).get(1)).exists() }
            )
        }
    }
}
