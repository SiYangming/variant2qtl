config {
    // Same as nf-test.config but allows optional *real* module tests.
    // Usage:
    //   bash scripts/run_real_nf_tests.sh susie
    //   bash scripts/run_real_nf_tests.sh tensorqtl
    // (script swaps this file into place for the duration of the run)

    testsDir = "."
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile = "tests/nextflow.config"

    ignore = [
        'modules/nf-core/**/tests/*',
        'subworkflows/nf-core/**/tests/*',
        '**/*.gwas_real.nf.test',
        // intentionally NOT ignoring *.tensorqtl_real / *.susie_real here
    ]

    profile = "test"

    triggers = [
        '.github/actions/nf-test/action.yml',
        '.github/workflows/nf-test.yml',
        'assets/schema_input.json',
        'bin/*',
        'conf/test.config',
        'conf/test_gwas.config',
        'conf/test_omiga.config',
        'nextflow.config',
        'nextflow_schema.json',
        'nf-test.config',
        'tests/.nftignore',
        'tests/nextflow.config',
    ]

    plugins {
        load "nft-utils@0.0.3"
    }
}
