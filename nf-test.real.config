config {
    // Same as nf-test.config but allows *real* smoke tests (manual / optional CI job).
    testsDir = "."
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile = "tests/nextflow.real.config"

    // Still skip vendored nf-core module suites; do NOT ignore local *real* smokes.
    ignore = [
        'modules/nf-core/**/tests/*',
        'subworkflows/nf-core/**/tests/*',
        '**/*.gwas_real.nf.test',
        '**/*.tensorqtl_real.nf.test',
        '**/*.susie_real.nf.test',
    ]

    profile = "test"

    plugins {
        load "nft-utils@0.0.3"
    }
}
