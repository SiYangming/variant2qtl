nextflow_pipeline {

    name "Test pipeline cis-QTL postprocess path"
    script "../main.nf"
    tag "pipeline"
    tag "qtl_postprocess"
    tag "stub"

    test("-profile test_postprocess path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_genotype_ingest    = false
                run_genotype_qc        = false
                run_gwas_benchmark     = false
                run_omiga_cis          = false
                run_tensorqtl_cis      = false
                run_qtltools_cis       = false
                run_finemap_susie      = false
                run_coloc              = false
                run_qtl_postprocess    = true
                qtl_postprocess_input  = "${projectDir}/assets/testdata/qtl_postprocess_mini/cis_qtl.tsv"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/qtl_postprocess/qtl_postprocess").exists() }
            )
        }
    }
}
