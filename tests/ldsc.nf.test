nextflow_pipeline {

    name "Test pipeline ldsc path"
    script "../main.nf"
    tag "pipeline"
    tag "ldsc"
    tag "stub"

    test("-profile test_ldsc path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_ldsc = true
                ldsc_sumstats = "${projectDir}/assets/testdata/ldsc_mini/sumstats.tsv"
                ldsc_annot = "${projectDir}/assets/testdata/ldsc_mini/annot.tsv"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/qtl_ldsc/ldsc_h2").exists() }
            )
        }
    }
}
