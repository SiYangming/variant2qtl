nextflow_pipeline {

    name "Test pipeline LeafCutter cluster path"
    script "../main.nf"
    tag "pipeline"
    tag "sqtl"
    tag "cluster"
    tag "stub"

    test("-profile test_leafcutter_cluster path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_leafcutter_cluster = true
                sqtl_bam = "${projectDir}/assets/testdata/str_mini/sample.bam"
                sqtl_bam_index = "${projectDir}/assets/testdata/str_mini/sample.bam.bai"
                sqtl_genes = "${projectDir}/assets/testdata/sqtl_leafcutter_mini/genes.bed"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/sqtl_leafcutter/regtools_junctionsextract").exists() },
                { assert path("$outputDir/sqtl_leafcutter/leafcutter_clusterregtools").exists() },
                { assert path("$outputDir/sqtl_leafcutter/leafcutter_prepare").exists() }
            )
        }
    }
}
