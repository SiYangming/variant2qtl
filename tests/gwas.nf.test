nextflow_pipeline {

    name "Test pipeline GWAS genotype path"
    script "../main.nf"
    tag "pipeline"
    tag "gwas"
    tag "stub"

    // Genotype samplesheet → ingest → QC → gemma/emmax → standardize under -stub.
    test("-profile test_gwas path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                genotype_input       = "${projectDir}/assets/genotype_samplesheet.csv"
                run_genotype_ingest  = true
                run_genotype_qc      = true
                run_gwas_benchmark   = true
                run_omiga_cis        = false

                gwas_benchmark_engines     = 'gemma,emmax'
                gwas_benchmark_standardize = true

                genotype_qc_args            = '--maf 0.01 --hwe 1e-6 --geno 0.2'
                genotype_qc_run_het         = false
                genotype_qc_run_relatedness = false
                genotype_qc_run_pca         = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/genotype_ingest").exists() },
                { assert path("$outputDir/genotype_qc/plink2_filter").exists() },
                { assert path("$outputDir/gwas_benchmark/gemma_lmm").exists() },
                { assert path("$outputDir/gwas_benchmark/emmax_assoc").exists() },
                { assert path("$outputDir/gwas_benchmark/assoc_standardize").exists() }
            )
        }
    }

    test("genotype_input bed path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                genotype_input       = "${projectDir}/assets/genotype_samplesheet_bed.csv"
                run_genotype_ingest  = false
                run_genotype_qc      = true
                run_gwas_benchmark   = true
                run_omiga_cis        = false

                gwas_benchmark_engines     = 'gemma,emmax'
                gwas_benchmark_standardize = true

                genotype_qc_args            = '--maf 0.01 --hwe 1e-6 --geno 0.2'
                genotype_qc_run_het         = false
                genotype_qc_run_relatedness = false
                genotype_qc_run_pca         = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/genotype_qc/plink2_filter").exists() },
                { assert path("$outputDir/gwas_benchmark/gemma_lmm").exists() },
                { assert path("$outputDir/gwas_benchmark/assoc_standardize").exists() }
            )
        }
    }
}
