nextflow_pipeline {

    name "Test pipeline str merge path"
    script "../main.nf"
    tag "pipeline"
    tag "str"
    tag "merge"
    tag "stub"

    test("-profile test_str_merge path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_str = true
                str_feed_ingest = true
                str_merge = true
                str_engines = 'expansionhunter,hipstr'
                str_bam = "${projectDir}/assets/testdata/str_mini/sample.bam"
                str_bam_index = "${projectDir}/assets/testdata/str_mini/sample.bam.bai"
                str_fasta = "${projectDir}/assets/testdata/str_mini/ref.fa"
                str_fasta_fai = "${projectDir}/assets/testdata/str_mini/ref.fa.fai"
                str_catalog = "${projectDir}/assets/testdata/str_mini/catalog.json"
                str_regions = "${projectDir}/assets/testdata/str_mini/regions.bed"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/variant_str/trtools_mergestr").exists() },
                { assert path("$outputDir/genotype_ingest/plink_vcf").exists() }
            )
        }
    }
}
