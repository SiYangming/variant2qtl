nextflow_pipeline {

    name "Test pipeline relate path"
    script "../main.nf"
    tag "pipeline"
    tag "relate"
    tag "stub"

    test("-profile test_relate path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_relate = true
                relate_vcf = "${projectDir}/assets/testdata/vcf_api_mini/multi.vcf.gz"
                relate_vcf_tbi = "${projectDir}/assets/testdata/vcf_api_mini/multi.vcf.gz.tbi"
                relate_fasta = "${projectDir}/assets/testdata/vcf_api_mini/ref.fa"
                relate_fasta_fai = "${projectDir}/assets/testdata/vcf_api_mini/ref.fa.fai"
                relate_sites = "${projectDir}/assets/testdata/vcf_api_mini/sites.vcf.gz"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/variant_relate/somalier_extract").exists() },
                { assert path("$outputDir/variant_relate/somalier_relate").exists() }
            )
        }
    }
}
