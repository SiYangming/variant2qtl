nextflow_pipeline {

    name "Test pipeline genotype QC extras path"
    script "../main.nf"
    tag "pipeline"
    tag "qc"
    tag "stub"

    test("-profile test_qc_extras path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                genotype_input = "${projectDir}/assets/genotype_samplesheet.csv"
                run_genotype_ingest = true
                run_genotype_qc = true
                genotype_qc_args = '--maf 0.01 --hwe 1e-6 --geno 0.2'
                genotype_qc_run_het = true
                genotype_qc_run_relatedness = true
                genotype_qc_run_pca = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/genotype_qc/plink2_filter").exists() },
                { assert path("$outputDir/genotype_qc/plink2_het").exists() },
                { assert path("$outputDir/genotype_qc/plink_genome").exists() },
                { assert path("$outputDir/genotype_qc/plink2_pca_bfile").exists() }
            )
        }
    }
}
