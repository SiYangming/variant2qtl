nextflow_pipeline {

    name "Test pipeline METAL path"
    script "../main.nf"
    tag "pipeline"
    tag "metal"
    tag "stub"

    test("-profile test_metal path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_genotype_ingest   = false
                run_genotype_qc       = false
                run_gwas_benchmark    = false
                run_omiga_cis         = false
                run_tensorqtl_cis     = false
                run_qtltools_cis      = false
                run_finemap_susie     = false
                run_qtl_postprocess   = false
                run_coloc             = false
                run_peer              = false
                run_phenotype_prepare = false
                run_sqtl_leafcutter   = false
                run_hyprcoloc         = false
                run_smr               = false
                run_mashr             = false
                run_torus             = false
                run_metal             = true
                metal_sumstats        = "${projectDir}/assets/testdata/metal_mini/cohorts.tsv"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/qtl_metal/metal_ivw").exists() }
            )
        }
    }
}
