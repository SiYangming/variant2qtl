nextflow_pipeline {

    name "Test pipeline PEER covariate path"
    script "../main.nf"
    tag "pipeline"
    tag "peer"
    tag "stub"

    test("-profile test_peer path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_genotype_ingest   = false
                run_genotype_qc       = false
                run_gwas_benchmark    = false
                run_omiga_cis         = false
                run_tensorqtl_cis     = false
                run_qtltools_cis      = false
                run_finemap_susie     = false
                run_qtl_postprocess   = false
                run_coloc             = false
                run_phenotype_prepare = false
                run_peer              = true
                peer_phenotype        = "${projectDir}/assets/testdata/peer_mini/phenotype.bed"
                peer_covariates       = "${projectDir}/assets/testdata/peer_mini/covariates.txt"
                peer_nk               = 2
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/covariate_peer/peer_factors").exists() }
            )
        }
    }
}
