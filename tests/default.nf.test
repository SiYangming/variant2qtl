nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // Ignore profile-dependent MultiQC plot binaries (conda often skips pdf/png/svg leaves).
            def stable_path = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: [
                    'pipeline_info/*.{html,json,txt}',
                    'multiqc/multiqc_plots/**',
                    'fastqc/*_fastqc.{html,zip}',
                    'multiqc/multiqc_report.html'
                ]
            )
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml without Nextflow version (multi-NXF CI)
                    removeNextflowVersion("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
