nextflow_pipeline {

    name "Test pipeline finemap_extra path"
    script "../main.nf"
    tag "pipeline"
    tag "finemap_extra"
    tag "stub"

    test("-profile test_finemap_extra path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_finemap_extra = true
                finemap_extra_sumstats = "${projectDir}/assets/testdata/finemap_susie_mini/sumstats.tsv"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/qtl_finemap_extra/finemap_extra").exists() }
            )
        }
    }
}
