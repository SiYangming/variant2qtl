nextflow_pipeline {

    name "Test pipeline FASTA index path"
    script "../main.nf"
    tag "pipeline"
    tag "fasta_index"
    tag "stub"

    test("-profile test_fasta_index path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_fasta_index = true
                fasta_index_fasta = "${projectDir}/assets/testdata/vcf_api_mini/ref.fa"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/reference_fasta/htslib_bgziptabix").exists() },
                { assert path("$outputDir/reference_fasta/samtools_faidx").exists() },
                { assert path("$outputDir/reference_fasta/samtools_dict").exists() }
            )
        }
    }
}
