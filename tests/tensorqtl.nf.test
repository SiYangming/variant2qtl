nextflow_pipeline {

    name "Test pipeline tensorQTL cis genotype path"
    script "../main.nf"
    tag "pipeline"
    tag "tensorqtl"
    tag "stub"

    // Genotype samplesheet → QC → tensorQTL cis under -stub.
    test("-profile test_tensorqtl path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                genotype_input       = "${projectDir}/assets/genotype_samplesheet_tensorqtl.csv"
                run_genotype_ingest  = false
                run_genotype_qc      = true
                run_gwas_benchmark   = false
                run_omiga_cis        = false
                run_tensorqtl_cis    = true
                tensorqtl_use_qc_bed = true
                run_finemap_susie    = false

                genotype_qc_args            = '--maf 0.01 --hwe 1e-6 --geno 0.2'
                genotype_qc_run_het         = false
                genotype_qc_run_relatedness = false
                genotype_qc_run_pca         = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/genotype_qc/plink2_filter").exists() },
                { assert path("$outputDir/molqtl_tensorqtl/tensorqtl_cis").exists() }
            )
        }
    }
}
