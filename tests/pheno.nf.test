nextflow_pipeline {

    name "Test pipeline phenotype_prepare path"
    script "../main.nf"
    tag "pipeline"
    tag "phenotype_prepare"
    tag "stub"

    test("-profile test_pheno path (stub)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/assets/samplesheet_stub.csv"
                igenomes_ignore = true
                validate_params = false

                run_genotype_ingest   = false
                run_genotype_qc       = false
                run_gwas_benchmark    = false
                run_omiga_cis         = false
                run_tensorqtl_cis     = false
                run_qtltools_cis      = false
                run_finemap_susie     = false
                run_qtl_postprocess   = false
                run_coloc             = false
                run_peer              = false
                run_phenotype_prepare = true
                phenotype_matrix      = "${projectDir}/assets/testdata/phenotype_prepare_mini/expr.tsv"
                phenotype_gene_bed    = "${projectDir}/assets/testdata/phenotype_prepare_mini/genes.bed"
                phenotype_samples     = "${projectDir}/assets/testdata/phenotype_prepare_mini/samples.txt"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/variant2qtl_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/phenotype_prepare/phenotype_prepare").exists() }
            )
        }
    }
}
