/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run . -profile test_qc_bgen,docker -stub --outdir results_test_qc_bgen
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test QC then BGEN profile'
    config_profile_description = 'ingest → QC → recode VCF → PLINK2_VCF2BGEN stub'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    genotype_input      = "${projectDir}/assets/genotype_samplesheet.csv"
    run_genotype_ingest = true
    run_genotype_qc     = true
    run_gwas_benchmark  = false
    run_omiga_cis       = false
    genotype_to_bgen    = true
    genotype_qc_args    = '--maf 0.01 --hwe 1e-6 --geno 0.2'
}
