/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for GWAS genotype-path smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises: PLINK bed → genotype_qc → gwas_benchmark (gemma+emmax) → assoc_standardize.
    Uses nf-core/test-datasets modules popgen data (plink_simulated).

    Prefer -stub for CI (engine containers / amd64 EMMAX). Example:

        nextflow run . -profile test_gwas,docker -stub --outdir results_test_gwas

    Real (non-stub) GEMMA is usually fine on amd64 docker; EMMAX may fail on arm64 hosts.

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test GWAS profile'
    config_profile_description = 'Minimal PLINK + phenotype smoke test for genotype QC and GWAS benchmark (gemma,emmax)'

    // Keep FASTQC/MultiQC template path working (same samplesheet as `test`)
    input  = params.pipelines_testdata_base_path + 'viralrecon/samplesheet/samplesheet_test_illumina_amplicon.csv'
    genome = 'R64-1-1'

    // Start from bed (skip ingest). Enable ingest + genotype_ingest_vcf instead of bed if desired.
    run_genotype_ingest  = false
    run_genotype_qc      = true
    run_gwas_benchmark   = true
    run_omiga_cis        = false

    gwas_benchmark_id          = 'plink_simulated'
    gwas_benchmark_engines     = 'gemma,emmax'
    gwas_benchmark_standardize = true

    // Hardcoded modules URLs so paths stay valid even when tests/nextflow.config
    // overrides pipelines_testdata_base_path to the variant2qtl branch.
    gwas_benchmark_bed = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/popgen/plink_simulated.bed'
    gwas_benchmark_bim = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/popgen/plink_simulated.bim'
    gwas_benchmark_fam = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/popgen/plink_simulated.fam'
    gwas_benchmark_vcf = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/popgen/plink_simulated.vcf.gz'

    gwas_benchmark_phenotype  = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe'
    gwas_benchmark_covariates = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/popgen/plink_simulated_covariates.txt'

    // Lenient QC for tiny simulated data
    genotype_qc_args            = '--maf 0.01 --hwe 1e-6 --geno 0.2'
    genotype_qc_run_het         = false
    genotype_qc_run_relatedness = false
    genotype_qc_run_pca         = false
}
