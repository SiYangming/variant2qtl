/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for GWAS genotype-path smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises genotype samplesheet → ingest (VCF) → QC → gwas_benchmark (gemma+emmax)
    → assoc_standardize. Uses assets/genotype_samplesheet.csv + nf-core plink_simulated.

    Prefer -stub for CI (engine containers / amd64 EMMAX). Example:

        nextflow run . -profile test_gwas,docker -stub --outdir results_test_gwas

    Real (non-stub) GEMMA is usually fine on amd64 docker; EMMAX may fail on arm64 hosts.

    Bed-only path (no ingest): use assets/genotype_samplesheet_bed.csv as --genotype_input.

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test GWAS profile'
    config_profile_description = 'Genotype samplesheet ingest → QC → GWAS (gemma,emmax) smoke test'

    // Keep FASTQC/MultiQC path working with local stub reads (no remote URL exists-checks)
    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    // Cohort samplesheet drives VCF ingest + pheno/covar (see assets/genotype_samplesheet.csv)
    genotype_input       = "${projectDir}/assets/genotype_samplesheet.csv"
    run_genotype_ingest  = true
    run_genotype_qc      = true
    run_gwas_benchmark   = true
    run_omiga_cis        = false
    run_tensorqtl_cis    = false
    run_finemap_susie    = false

    gwas_benchmark_engines     = 'gemma,emmax'
    gwas_benchmark_standardize = true

    // Lenient QC for tiny simulated data
    genotype_qc_args            = '--maf 0.01 --hwe 1e-6 --geno 0.2'
    genotype_qc_run_het         = false
    genotype_qc_run_relatedness = false
    genotype_qc_run_pca         = false
}
