/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for phase scatter/gather smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run . -profile test_phase_scatter,docker -stub --outdir results_test_phase_scatter
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: 'SHAPEIT5_PHASECOMMON' {
        container = 'quay.io/biocontainers/python:3.9--1'
    }
}

params {
    config_profile_name        = 'Test phase scatter profile'
    config_profile_description = 'SHAPEIT5 scatter/gather stub from mini VCF + BED'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    run_genotype_ingest   = false
    run_genotype_qc       = false
    run_gwas_benchmark    = false
    run_omiga_cis         = false
    run_tensorqtl_cis     = false
    run_qtltools_cis      = false
    run_finemap_susie     = false
    run_qtl_postprocess   = false
    run_coloc             = false
    run_peer              = false
    run_phenotype_prepare = false
    run_sqtl_leafcutter   = false
    run_hyprcoloc         = false
    run_smr               = false
    run_mashr             = false
    run_metal             = false
    run_torus             = false
    run_twas              = false
    run_ldsc              = false
    run_finemap_extra     = false
    run_snp_indel         = false
    run_sv                = false
    run_str               = false
    run_eqtl              = false
    run_sqtl              = false
    run_pqtl              = false
    run_gqtl              = false
    run_annotate          = false
    run_phase             = true
    run_impute            = false

    phase_vcf = "${projectDir}/assets/testdata/vcf_api_mini/sample.vcf.gz"
    phase_vcf_tbi = "${projectDir}/assets/testdata/vcf_api_mini/sample.vcf.gz.tbi"
    phase_ref_vcf = "${projectDir}/assets/testdata/vcf_api_mini/ref.vcf.gz"
    phase_ref_vcf_tbi = "${projectDir}/assets/testdata/vcf_api_mini/ref.vcf.gz.tbi"
    phase_map = "${projectDir}/assets/testdata/vcf_api_mini/genetic_map.txt"
    phase_scatter_bed = "${projectDir}/assets/testdata/vcf_api_mini/scatter.bed"
    phase_scatter_count = 2
}
