/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run . -profile test_bgen,docker -stub --outdir results_test_bgen
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test BGEN export profile'
    config_profile_description = 'ingest VCF → PLINK2_VCF2BGEN stub'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    genotype_input       = "${projectDir}/assets/genotype_samplesheet.csv"
    run_genotype_ingest  = true
    run_genotype_qc      = false
    run_gwas_benchmark   = false
    run_omiga_cis        = false
    genotype_to_bgen     = true
}
