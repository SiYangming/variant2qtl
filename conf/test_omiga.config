/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for OmiGA cis samplesheet smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises genotype samplesheet → QC → OmiGA cis (molqtl_map_omiga) using
    assets/genotype_samplesheet_omiga.csv + assets/testdata/omiga_cis_mini/.

    Prefer -stub for CI:

        nextflow run . -profile test_omiga,docker -stub --outdir results_test_omiga

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test OmiGA cis profile'
    config_profile_description = 'Genotype samplesheet → QC → OmiGA cis smoke test'

    // Keep FASTQC/MultiQC path working with local stub reads
    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    genotype_input       = "${projectDir}/assets/genotype_samplesheet_omiga.csv"
    run_genotype_ingest  = false
    run_genotype_qc      = true
    run_gwas_benchmark   = false
    run_omiga_cis        = true
    omiga_cis_use_qc_bed = true

    // Lenient QC for tiny simulated data
    genotype_qc_args            = '--maf 0.01 --hwe 1e-6 --geno 0.2'
    genotype_qc_run_het         = false
    genotype_qc_run_relatedness = false
    genotype_qc_run_pca         = false
}
