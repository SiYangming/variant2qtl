/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for QTLtools cis samplesheet smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises genotype samplesheet → QC → QTLtools cis using
    assets/genotype_samplesheet_qtltools.csv + assets/testdata/omiga_cis_mini/.

    Prefer -stub for CI:

        nextflow run . -profile test_qtltools,docker -stub --outdir results_test_qtltools

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test QTLtools cis profile'
    config_profile_description = 'Genotype samplesheet → QC → QTLtools cis smoke test'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    genotype_input         = "${projectDir}/assets/genotype_samplesheet_qtltools.csv"
    run_genotype_ingest    = false
    run_genotype_qc        = true
    run_gwas_benchmark     = false
    run_omiga_cis          = false
    run_tensorqtl_cis      = false
    run_qtltools_cis       = true
    qtltools_use_qc_bed    = true
    run_finemap_susie      = false
    run_coloc              = false
    run_qtl_postprocess    = false

    genotype_qc_args            = '--maf 0.01 --hwe 1e-6 --geno 0.2'
    genotype_qc_run_het         = false
    genotype_qc_run_relatedness = false
    genotype_qc_run_pca         = false
}
