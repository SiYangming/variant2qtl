/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run . -profile test_vcf_prep_qc,docker -stub --outdir results_test_vcf_prep_qc
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: 'ENSEMBLVEP_VEP|SNPEFF_SNPEFF|SHAPEIT5_PHASECOMMON|BEAGLE5_BEAGLE|MINIMAC4_IMPUTE|GLIMPSE_PHASE' {
        container = 'quay.io/biocontainers/python:3.9--1'
    }
}

params {
    config_profile_name        = 'Test vcf_prep QC profile'
    config_profile_description = 'vcf_prep → ingest → genotype QC stub'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    run_genotype_ingest   = false
    run_genotype_qc       = true
    run_gwas_benchmark    = false
    run_omiga_cis         = false
    run_tensorqtl_cis     = false
    run_qtltools_cis      = false
    run_finemap_susie     = false
    run_qtl_postprocess   = false
    run_coloc             = false
    run_peer              = false
    run_phenotype_prepare = false
    run_sqtl_leafcutter   = false
    run_hyprcoloc         = false
    run_smr               = false
    run_mashr             = false
    run_metal             = false
    run_torus             = false
    run_twas              = false
    run_ldsc              = false
    run_finemap_extra     = false
    run_snp_indel         = false
    run_sv                = false
    run_str               = false
    run_eqtl              = false
    run_sqtl              = false
    run_pqtl              = false
    run_gqtl              = false
    run_annotate          = false
    run_phase             = false
    run_impute            = false
    run_relate            = false
    run_vcf_prep          = true
    vcf_prep_feed_ingest  = true
    run_cache             = false
    run_impute_bam        = false
    run_fasta_index       = false

    vcf_prep_vcf = "${projectDir}/assets/testdata/vcf_api_mini/sample.vcf.gz"
    vcf_prep_vcf_tbi = "${projectDir}/assets/testdata/vcf_api_mini/sample.vcf.gz.tbi"
    annotate_tools = 'snpeff'
    annotate_snpeff_db = 'GRCh38.99'
    annotate_snpeff_cache = "${projectDir}/assets/testdata/vcf_api_mini/snpeff_cache"
    phase_ref_vcf = "${projectDir}/assets/testdata/vcf_api_mini/ref.vcf.gz"
    phase_ref_vcf_tbi = "${projectDir}/assets/testdata/vcf_api_mini/ref.vcf.gz.tbi"
    phase_map = "${projectDir}/assets/testdata/vcf_api_mini/genetic_map.txt"
    phase_region = '1'
    impute_engine = 'beagle5'
    impute_panel = "${projectDir}/assets/testdata/vcf_api_mini/ref.vcf.gz"
    impute_panel_tbi = "${projectDir}/assets/testdata/vcf_api_mini/ref.vcf.gz.tbi"
    impute_map = "${projectDir}/assets/testdata/vcf_api_mini/genetic_map.txt"
    impute_region = '1'
}
