/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    // GWAS benchmark branch outputs
    withName: '.*:GWAS_BENCHMARK_PARALLEL:.*' {
        publishDir = [
            path: { "${params.outdir}/gwas_benchmark/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:GENOTYPE_QC:.*' {
        publishDir = [
            path: { "${params.outdir}/genotype_qc/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:GENOTYPE_INGEST_HARMONIZE:.*' {
        publishDir = [
            path: { "${params.outdir}/genotype_ingest/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:GENOTYPE_TO_ANALYSIS_FORMAT:.*' {
        publishDir = [
            path: { "${params.outdir}/genotype_analysis/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLINK_RECODE_QC_VCF' {
        ext.args = 'vcf-iid bgz'
        ext.prefix = { "${meta.id}.qc" }
        publishDir = [
            path: { "${params.outdir}/genotype_qc/plink_recode_vcf" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MOLQTL_MAP_OMIGA:.*' {
        publishDir = [
            path: { "${params.outdir}/molqtl_omiga/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MOLQTL_MAP_OMIGA:OMIGA_CIS' {
        ext.mode = 'cis'
    }

    withName: '.*:MOLQTL_MAP_OMIGA:OMIGA_TRANS' {
        ext.mode = 'trans'
    }

    withName: '.*:MOLQTL_MAP_OMIGA:OMIGA_INDEPENDENT' {
        ext.mode = 'independent-cis'
    }

    withName: '.*:MOLQTL_MAP_TENSORQTL:.*' {
        publishDir = [
            path: { "${params.outdir}/molqtl_tensorqtl/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_FINEMAP_SUSIE:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_finemap_susie/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MOLQTL_MAP_QTLTOOLS:.*' {
        publishDir = [
            path: { "${params.outdir}/molqtl_qtltools/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MOLQTL_MAP_MATRIXEQTL:.*' {
        publishDir = [
            path: { "${params.outdir}/molqtl_matrixeqtl/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_COLOC:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_coloc/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_POSTPROCESS_CIS:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_postprocess/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PHENOTYPE_PREPARE_SWF:.*' {
        ext.args = { "--transform ${params.phenotype_transform} --max-missing ${params.phenotype_max_missing}" }
        publishDir = [
            path: { "${params.outdir}/phenotype_prepare/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:COVARIATE_PEER:.*' {
        ext.args = { "--nk ${params.peer_nk}" }
        publishDir = [
            path: { "${params.outdir}/covariate_peer/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:SQTL_LEAFCUTTER:.*' {
        publishDir = [
            path: { "${params.outdir}/sqtl_leafcutter/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_HYPRCOLOC:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_hyprcoloc/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_SMR:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_smr/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_MASHR:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_mashr/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_METAL:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_metal/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_TORUS:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_torus/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_TWAS:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_twas/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_TWAS:TWAS_PREDICTDB' {
        publishDir = [
            path: { "${params.outdir}/qtl_twas/twas_predictdb" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_LDSC:.*' {
        publishDir = [
            path: { "${params.outdir}/qtl_ldsc/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QTL_FINEMAP_EXTRA:.*' {
        ext.args = { "--method ${params.finemap_extra_method}" }
        publishDir = [
            path: { "${params.outdir}/qtl_finemap_extra/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VARIANT_RELATE:.*' {
        publishDir = [
            path: { "${params.outdir}/variant_relate/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SOMALIER_OUTLIERS|PLINK2_REMOVE_SOMALIER' {
        publishDir = [
            path: { "${params.outdir}/genotype_qc/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VARIANT_ANNOTATE:.*' {
        publishDir = [
            path: { "${params.outdir}/variant_annotate/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VCF_ANNOTATE_ENSEMBLVEP_SNPEFF:COMPRESS_VCF' {
        ext.prefix = { "${meta.id}.snpeff" }
    }

    withName: '.*:VCF_ANNOTATE_ENSEMBLVEP_SNPEFF:INDEX_VCF' {
        // Distinct from COMPRESS_VCF / input basename so stub and bgzip-symlink paths do not collide
        ext.prefix = { "${meta.id}.final" }
    }

    withName: '.*:VCF_ANNOTATE_ENSEMBLVEP_SNPEFF:BCFTOOLS_CONCAT' {
        ext.prefix = { "${meta.id}_concat" }
    }

    withName: '.*:VCF_ANNOTATE_ENSEMBLVEP_SNPEFF:ENSEMBLVEP_VEP' {
        ext.prefix = { "${meta.id}.vep" }
        ext.args = { '--vcf --offline --no_stats' }
    }

    withName: '.*:VCF_FILTER_BCFTOOLS_ENSEMBLVEP:BCFTOOLS_VIEW' {
        ext.args = { ['--output-type z', '--write-index=tbi'].join(' ') }
    }

    withName: '.*:VARIANT_PHASE:.*' {
        publishDir = [
            path: { "${params.outdir}/variant_phase/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VARIANT_IMPUTE:.*' {
        publishDir = [
            path: { "${params.outdir}/variant_impute/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ANNOTATION_CACHE:.*' {
        publishDir = [
            path: { "${params.outdir}/annotation_cache/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VARIANT_IMPUTE_BAM:.*' {
        publishDir = [
            path: { "${params.outdir}/variant_impute_bam/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:REFERENCE_FASTA:.*' {
        publishDir = [
            path: { "${params.outdir}/reference_fasta/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VARIANT_SV:.*' {
        publishDir = [
            path: { "${params.outdir}/variant_sv/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VARIANT_STR:.*' {
        publishDir = [
            path: { "${params.outdir}/variant_str/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BED_TO_REGION' {
        ext.prefix = { bed.name.replaceFirst(/\.bed$/, '') }
        publishDir = [
            path: { "${params.outdir}/scatter/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VCF_GATHER_REGIONS:.*|.*:VCF_GATHER_PHASE:.*|.*:VCF_GATHER_IMPUTE:.*' {
        ext.prefix = { "${meta.group_id ?: meta.id}" }
        publishDir = [
            path: { "${params.outdir}/scatter/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:VCF_GATHER_REGIONS:BCFTOOLS_CONCAT|.*:VCF_GATHER_PHASE:BCFTOOLS_CONCAT|.*:VCF_GATHER_IMPUTE:BCFTOOLS_CONCAT' {
        ext.prefix = { "${meta.group_id ?: meta.id}_concat" }
    }

    withName: '.*:VARIANT_SV:SMOOVE_CALL' {
        ext.prefix = { "${meta.id}_smoove" }
    }

    withName: '.*:VARIANT_SV:DELLY_CALL' {
        ext.prefix = { "${meta.id}_delly" }
    }

    withName: '.*:VARIANT_SV:MANTA_GERMLINE' {
        ext.prefix = { "${meta.id}_manta" }
    }

    withName: '.*:VARIANT_SV:SURVIVOR_MERGE' {
        ext.prefix = { "${meta.group_id ?: meta.id}_merged" }
    }

    withName: '.*:VARIANT_STR:BCFTOOLS_INDEX_STR' {
        ext.args = '-t'
    }

    withName: '.*:VARIANT_STR:EXPANSIONHUNTER' {
        ext.prefix = { "${meta.id}_eh" }
    }

    withName: '.*:VARIANT_STR:GANGSTR' {
        ext.prefix = { "${meta.id}_gangstr" }
    }

    withName: '.*:VARIANT_STR:HIPSTR' {
        ext.prefix = { "${meta.id}_hipstr" }
    }

    withName: '.*:VARIANT_STR:TRGT_GENOTYPE' {
        ext.prefix = { "${meta.id}_trgt" }
    }

    withName: '.*:VARIANT_STR:TRTOOLS_MERGESTR' {
        ext.prefix = { "${meta.group_id ?: meta.id}_merged" }
    }

}
