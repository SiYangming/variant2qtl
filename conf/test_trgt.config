/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run . -profile test_trgt,docker -stub --outdir results_test_trgt
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: 'EXPANSIONHUNTER|GANGSTR|HIPSTR|TRGT_GENOTYPE' {
        container = 'quay.io/biocontainers/python:3.9--1'
    }
}

params {
    config_profile_name        = 'Test TRGT STR profile'
    config_profile_description = 'TRGT STR stub from mini BAM/regions'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    run_genotype_ingest   = false
    run_genotype_qc       = false
    run_gwas_benchmark    = false
    run_omiga_cis         = false
    run_tensorqtl_cis     = false
    run_qtltools_cis      = false
    run_finemap_susie     = false
    run_qtl_postprocess   = false
    run_coloc             = false
    run_peer              = false
    run_phenotype_prepare = false
    run_sqtl_leafcutter   = false
    run_hyprcoloc         = false
    run_smr               = false
    run_mashr             = false
    run_metal             = false
    run_torus             = false
    run_twas              = false
    run_finemap_extra     = false
    run_snp_indel         = false
    run_sv                = false
    run_str               = true
    str_engines           = 'trgt'
    str_bam               = "${projectDir}/assets/testdata/str_mini/sample.bam"
    str_bam_index         = "${projectDir}/assets/testdata/str_mini/sample.bam.bai"
    str_fasta             = "${projectDir}/assets/testdata/str_mini/ref.fa"
    str_fasta_fai         = "${projectDir}/assets/testdata/str_mini/ref.fa.fai"
    str_regions           = "${projectDir}/assets/testdata/str_mini/regions.bed"
}
