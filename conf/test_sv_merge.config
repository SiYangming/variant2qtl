/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run . -profile test_sv_merge,docker -stub --outdir results_test_sv_merge
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: 'SMOOVE_CALL|MANTA_GERMLINE|DELLY_CALL|SURVIVOR_MERGE' {
        container = 'quay.io/biocontainers/python:3.9--1'
    }
}

params {
    config_profile_name        = 'Test sv merge profile'
    config_profile_description = 'smoove+delly SURVIVOR merge then ingest'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    run_genotype_ingest   = false
    run_genotype_qc       = false
    run_gwas_benchmark    = false
    run_omiga_cis         = false
    run_tensorqtl_cis     = false
    run_qtltools_cis      = false
    run_finemap_susie     = false
    run_qtl_postprocess   = false
    run_coloc             = false
    run_peer              = false
    run_phenotype_prepare = false
    run_sqtl_leafcutter   = false
    run_hyprcoloc         = false
    run_smr               = false
    run_mashr             = false
    run_metal             = false
    run_torus             = false
    run_twas              = false
    run_finemap_extra     = false
    run_snp_indel         = false
    run_sv                = true
    run_str               = false
    sv_feed_ingest        = true
    sv_merge              = true
    sv_engines            = 'smoove,delly'
    sv_bam                = "${projectDir}/assets/testdata/sv_mini/sample.bam"
    sv_bam_index          = "${projectDir}/assets/testdata/sv_mini/sample.bam.bai"
    sv_fasta              = "${projectDir}/assets/testdata/sv_mini/ref.fa"
    sv_fasta_fai          = "${projectDir}/assets/testdata/sv_mini/ref.fa.fai"
}
