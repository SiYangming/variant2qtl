/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for SuSiE fine-mapping smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises SuSiE on mini sumstats under assets/testdata/finemap_susie_mini/.

    Prefer -stub for CI:

        nextflow run . -profile test_finemap,docker -stub --outdir results_test_finemap

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test SuSiE fine-mapping profile'
    config_profile_description = 'SuSiE fine-mapping smoke test from summary statistics'

    // Keep FASTQC/MultiQC path working with local stub reads
    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    run_genotype_ingest  = false
    run_genotype_qc      = false
    run_gwas_benchmark   = false
    run_omiga_cis        = false
    run_tensorqtl_cis    = false
    run_finemap_susie    = true
    finemap_susie_sumstats = "${projectDir}/assets/testdata/finemap_susie_mini/sumstats.tsv"
    finemap_susie_ld       = "${projectDir}/assets/testdata/finemap_susie_mini/ld.txt"
}
