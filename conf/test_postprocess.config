/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for cis-QTL postprocess smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises qtl_postprocess on assets/testdata/qtl_postprocess_mini/. Prefer -stub:

        nextflow run . -profile test_postprocess,docker -stub --outdir results_test_postprocess

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test cis-QTL postprocess profile'
    config_profile_description = 'BH q-value / standard cis table smoke test'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    run_genotype_ingest    = false
    run_genotype_qc        = false
    run_gwas_benchmark     = false
    run_omiga_cis          = false
    run_tensorqtl_cis      = false
    run_qtltools_cis       = false
    run_finemap_susie      = false
    run_coloc              = false
    run_qtl_postprocess    = true
    qtl_postprocess_input  = "${projectDir}/assets/testdata/qtl_postprocess_mini/cis_qtl.tsv"
}
