/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for somalier relate smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        nextflow run . -profile test_relate,docker -stub --outdir results_test_relate
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: 'SOMALIER_EXTRACT|SOMALIER_RELATE' {
        container = 'quay.io/biocontainers/python:3.9--1'
    }
}

params {
    config_profile_name        = 'Test relate profile'
    config_profile_description = 'Somalier extract/relate stub'

    input  = "${projectDir}/assets/samplesheet_stub.csv"
    genome = 'R64-1-1'
    igenomes_ignore = true
    validate_params = false

    run_genotype_ingest   = false
    run_genotype_qc       = false
    run_gwas_benchmark    = false
    run_omiga_cis         = false
    run_tensorqtl_cis     = false
    run_qtltools_cis      = false
    run_finemap_susie     = false
    run_qtl_postprocess   = false
    run_coloc             = false
    run_peer              = false
    run_phenotype_prepare = false
    run_sqtl_leafcutter   = false
    run_hyprcoloc         = false
    run_smr               = false
    run_mashr             = false
    run_metal             = false
    run_torus             = false
    run_twas              = false
    run_ldsc              = false
    run_finemap_extra     = false
    run_snp_indel         = false
    run_sv                = false
    run_str               = false
    run_eqtl              = false
    run_sqtl              = false
    run_pqtl              = false
    run_gqtl              = false
    run_annotate          = false
    run_phase             = false
    run_impute            = false
    run_vcf_prep          = false
    run_relate            = false

    run_relate = true
    relate_vcf = "${projectDir}/assets/testdata/vcf_api_mini/multi.vcf.gz"
    relate_vcf_tbi = "${projectDir}/assets/testdata/vcf_api_mini/multi.vcf.gz.tbi"
    relate_fasta = "${projectDir}/assets/testdata/vcf_api_mini/ref.fa"
    relate_fasta_fai = "${projectDir}/assets/testdata/vcf_api_mini/ref.fa.fai"
    relate_sites = "${projectDir}/assets/testdata/vcf_api_mini/sites.vcf.gz"
}
