config {
    // location for all nf-test tests
    testsDir = "."

    // nf-test directory including temporary files for each test
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // location of an optional nextflow.config file specific for executing tests
    configFile = "tests/nextflow.config"

    // ignore tests coming from the nf-core/modules repo
    // Also skip local *real* nf-tests (heavy downloads, conda engines, amd64-only binaries)
    ignore = [
        'modules/nf-core/**/tests/*',
        'subworkflows/nf-core/**/tests/*',
        '**/*.gwas_real.nf.test',
        '**/*.tensorqtl_real.nf.test',
        '**/*.susie_real.nf.test',
        '**/*.ldsc_real.nf.test',
        '**/*.predictdb_real.nf.test',
        '**/*.vep_real.nf.test',
        '**/*.shapeit5_real.nf.test',
        '**/*.beagle_real.nf.test',
    ]

    // run all test with defined profile(s) from the main nextflow.config
    profile = "test"

    // list of filenames or patterns that should be trigger a full test run
    triggers = [
        '.github/actions/nf-test/action.yml',
        '.github/workflows/nf-test.yml',
        'assets/schema_input.json',
        'bin/*',
        'conf/test.config',
        'conf/test_gwas.config',
        'conf/test_omiga.config',
        'conf/test_tensorqtl.config',
        'conf/test_finemap.config',
        'conf/test_coloc.config',
        'conf/test_qtltools.config',
        'conf/test_postprocess.config',
        'conf/test_pheno.config',
        'conf/test_peer.config',
        'conf/test_sqtl.config',
        'conf/test_hyprcoloc.config',
        'conf/test_smr.config',
        'conf/test_mashr.config',
        'conf/test_metal.config',
        'conf/test_torus.config',
        'conf/test_twas.config',
        'conf/test_finemap_extra.config',
        'conf/test_sv.config',
        'conf/test_str.config',
        'conf/test_snp_indel.config',
        'conf/test_eqtl.config',
        'conf/test_modality_sqtl.config',
        'conf/test_pqtl.config',
        'conf/test_gqtl.config',
        'conf/test_ldsc.config',
        'conf/test_twas_predictdb.config',
        'conf/test_annotate.config',
        'conf/test_phase.config',
        'conf/test_impute.config',
        'conf/test_relate.config',
        'conf/test_vcf_prep.config',
        'conf/test_cache.config',
        'conf/test_impute_bam.config',
        'conf/test_fasta_index.config',
        'nextflow.config',
        'nextflow_schema.json',
        'nf-test.config',
        'tests/.nftignore',
        'tests/nextflow.config',
    ]

    // load the necessary plugins
    plugins {
        load "nft-utils@0.0.3"
    }
}
