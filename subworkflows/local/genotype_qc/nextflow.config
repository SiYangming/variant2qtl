/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defaults for GENOTYPE_QC (PLINK2_FILTER)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: '.*:GENOTYPE_QC:PLINK2_FILTER' {
        // Minimal SNP QC; override via modules.config if needed
        ext.args   = { params.genotype_qc_args ?: '--maf 0.05 --hwe 1e-6 --geno 0.1' }
        ext.prefix = { "${meta.id}_qc" }
    }
}
