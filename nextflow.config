/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SiYangming/variant2qtl Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // NOTE: Specify your pipeline's command line flags
    // Input options
    input                      = null
    // Optional cohort genotype samplesheet (VCF and/or PLINK + pheno/covar). Prefer over
    // scattered --gwas_benchmark_* / --genotype_ingest_vcf file params when set.
    genotype_input             = null

    // GWAS benchmark branch (default OFF — main workflow unchanged when false)
    run_gwas_benchmark           = false
    gwas_benchmark_id            = 'gwas_benchmark'
    gwas_benchmark_bed           = null
    gwas_benchmark_bim           = null
    gwas_benchmark_fam           = null
    gwas_benchmark_vcf           = null
    gwas_benchmark_phenotype     = null
    gwas_benchmark_covariates    = null
    gwas_benchmark_standardize   = true
    gwas_benchmark_engines       = 'gemma,emmax,tassel,rmvp,omiga'

    // Genotype ingest: VCF → (optional liftover/norm/samples) → PLINK bed (default OFF)
    run_genotype_ingest              = false
    genotype_ingest_vcf              = null
    genotype_ingest_args             = '--make-bed --double-id --allow-extra-chr --vcf-half-call missing'
    genotype_ingest_fasta            = null
    genotype_ingest_norm_args        = '--output-type z --check-ref w -m -both'
    genotype_ingest_samples          = null
    genotype_ingest_view_args        = '--output-type z'
    genotype_ingest_liftover_chain   = null
    genotype_ingest_liftover_fasta   = null
    genotype_ingest_liftover_dict    = null

    // Genotype QC (default OFF); FILTER always; het/relatedness/PCA opt-in
    run_genotype_qc                  = false
    genotype_qc_args                 = '--maf 0.05 --hwe 1e-6 --geno 0.1'
    genotype_qc_run_het              = false
    genotype_qc_het_sd               = 3.0
    genotype_qc_run_relatedness      = false
    genotype_qc_pi_hat               = 0.185
    genotype_qc_run_pca              = false
    genotype_qc_pca_n                = 10

    // Analysis-format fan-out (used by molqtl_map_omiga)
    genotype_to_bgen                 = false
    genotype_bgen_dosage             = 'DS'

    // OmiGA cis molQTL (default OFF — main workflow unchanged when false)
    run_omiga_cis                    = false
    omiga_cis_id                     = 'omiga_cis'
    omiga_cis_bed                    = null
    omiga_cis_bim                    = null
    omiga_cis_fam                    = null
    omiga_cis_vcf                    = null
    omiga_cis_phenotype              = null
    omiga_cis_covariates             = null
    omiga_cis_use_qc_bed             = false

    // tensorQTL cis molQTL (default OFF — main workflow unchanged when false)
    run_tensorqtl_cis                = false
    tensorqtl_cis_id                 = 'tensorqtl_cis'
    tensorqtl_cis_bed                = null
    tensorqtl_cis_bim                = null
    tensorqtl_cis_fam                = null
    tensorqtl_cis_phenotype          = null
    tensorqtl_cis_covariates         = null
    tensorqtl_use_qc_bed             = false

    // SuSiE fine-mapping (default OFF)
    run_finemap_susie                = false
    finemap_susie_id                 = 'finemap_susie'
    finemap_susie_sumstats           = null
    finemap_susie_ld                 = null

    // QTL–GWAS coloc.abf (default OFF; hyprcoloc not wired)
    run_coloc                        = false
    coloc_id                         = 'coloc'
    coloc_qtl_sumstats               = null
    coloc_gwas_sumstats              = null

    // QTLtools cis molQTL (default OFF)
    run_qtltools_cis                 = false
    qtltools_cis_id                  = 'qtltools_cis'
    qtltools_cis_bed                 = null
    qtltools_cis_bim                 = null
    qtltools_cis_fam                 = null
    qtltools_cis_phenotype           = null
    qtltools_cis_covariates          = null
    qtltools_use_qc_bed              = false

    // Unified cis-QTL table + BH q-values (default OFF)
    run_qtl_postprocess              = false
    qtl_postprocess_id               = 'qtl_postprocess'
    qtl_postprocess_input            = null

    // Molecular phenotype prepare (default OFF)
    run_phenotype_prepare            = false
    phenotype_prepare_id             = 'phenotype_prepare'
    phenotype_matrix                 = null
    phenotype_gene_bed               = null
    phenotype_samples                = null
    phenotype_transform              = 'invnorm'
    phenotype_max_missing            = 0.2

    // PEER hidden covariates (default OFF)
    run_peer                         = false
    peer_id                          = 'peer'
    peer_phenotype                   = null
    peer_covariates                  = null
    peer_nk                          = 10

    // LeafCutter sQTL phenotype (default OFF)
    run_sqtl_leafcutter              = false
    sqtl_id                          = 'sqtl_leafcutter'
    sqtl_counts                      = null
    sqtl_genes                       = null

    // HyPrColoc-style multi-trait clustering (default OFF)
    run_hyprcoloc                    = false
    hyprcoloc_id                     = 'hyprcoloc'
    hyprcoloc_sumstats               = null

    // SMR / HEIDI (default OFF)
    run_smr                          = false
    smr_id                           = 'smr'
    smr_qtl_sumstats                 = null
    smr_gwas_sumstats                = null

    // mashr multi-condition shrinkage (default OFF)
    run_mashr                        = false
    mashr_id                         = 'mashr'
    mashr_sumstats                   = null

    // METAL inverse-variance meta (default OFF)
    run_metal                        = false
    metal_id                         = 'metal'
    metal_sumstats                   = null

    // TORUS enrichment prior (default OFF)
    run_torus                        = false
    torus_id                         = 'torus'
    torus_annot                      = null

    // TWAS (default OFF)
    run_twas                         = false
    twas_id                          = 'twas'
    twas_weights                     = null
    twas_gwas                        = null
    twas_ld                          = null

    // LDSC heritability (default OFF)
    run_ldsc                         = false
    ldsc_id                          = 'ldsc'
    ldsc_sumstats                    = null
    ldsc_annot                       = null
    ldsc_ldscores                    = null

    // QTL modality umbrellas (default OFF)
    run_eqtl                         = false
    run_sqtl                         = false
    run_pqtl                         = false
    run_gqtl                         = false
    qtl_modality_engine              = 'omiga'

    // FINEMAP / CAVIAR / DAP-G (default OFF)
    run_finemap_extra                = false
    finemap_extra_id                 = 'finemap_extra'
    finemap_extra_sumstats           = null
    finemap_extra_method             = 'finemap'

    // P3 SNP/Indel umbrella (default OFF): ingest + QC + OmiGA cis
    run_snp_indel                    = false

    // VCF annotate / phase / impute (default OFF; nf-core modules)
    run_annotate                     = false
    annotate_id                      = 'annotate'
    annotate_tools                   = 'snpeff'
    annotate_vcf                     = null
    annotate_vcf_tbi                 = null
    annotate_fasta                   = null
    annotate_vep_genome              = null
    annotate_vep_species             = 'homo_sapiens'
    annotate_vep_cache_version       = '110'
    annotate_vep_cache               = null
    annotate_snpeff_db               = 'GRCh38.99'
    annotate_snpeff_cache            = null

    run_phase                        = false
    phase_id                         = 'phase'
    phase_vcf                        = null
    phase_vcf_tbi                    = null
    phase_ref_vcf                    = null
    phase_ref_vcf_tbi                = null
    phase_map                        = null
    phase_region                     = '1'

    run_impute                       = false
    impute_id                        = 'impute'
    impute_engine                    = 'beagle5'
    impute_vcf                       = null
    impute_vcf_tbi                   = null
    impute_panel                     = null
    impute_panel_tbi                 = null
    impute_map                       = null
    impute_region                    = '1'

    // annotate → phase → impute umbrella (default OFF)
    run_vcf_prep                     = false
    vcf_prep_vcf                     = null
    vcf_prep_vcf_tbi                 = null
    vcf_prep_skip_annotate           = false
    vcf_prep_skip_phase              = false
    vcf_prep_skip_impute             = false

    // Somalier relatedness (default OFF)
    run_relate                       = false
    relate_id                        = 'relate'
    relate_vcf                       = null
    relate_vcf_tbi                   = null
    relate_fasta                     = null
    relate_fasta_fai                 = null
    relate_sites                     = null
    relate_ped                       = null
    genotype_qc_use_somalier         = false
    genotype_qc_somalier_pairs       = null
    genotype_qc_somalier_relatedness = 0.2

    // P3 SV calling (default OFF)
    run_sv                           = false
    sv_id                            = 'sv'
    sv_engines                       = 'smoove'
    sv_bam                           = null
    sv_bam_index                     = null
    sv_fasta                         = null
    sv_fasta_fai                     = null

    // P3 STR genotyping (default OFF)
    run_str                          = false
    str_id                           = 'str'
    str_engines                      = 'expansionhunter'
    str_bam                          = null
    str_bam_index                    = null
    str_fasta                        = null
    str_fasta_fai                    = null
    str_catalog                      = null
    str_regions                      = null
    str_repeats                      = null
    str_hipstr_bed                   = null

    // References
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // NOTE: https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_gwas { includeConfig 'conf/test_gwas.config' }
    test_omiga { includeConfig 'conf/test_omiga.config' }
    test_tensorqtl { includeConfig 'conf/test_tensorqtl.config' }
    test_finemap { includeConfig 'conf/test_finemap.config' }
    test_coloc { includeConfig 'conf/test_coloc.config' }
    test_qtltools { includeConfig 'conf/test_qtltools.config' }
    test_postprocess { includeConfig 'conf/test_postprocess.config' }
    test_pheno { includeConfig 'conf/test_pheno.config' }
    test_peer { includeConfig 'conf/test_peer.config' }
    test_sqtl { includeConfig 'conf/test_sqtl.config' }
    test_hyprcoloc { includeConfig 'conf/test_hyprcoloc.config' }
    test_smr { includeConfig 'conf/test_smr.config' }
    test_mashr { includeConfig 'conf/test_mashr.config' }
    test_metal { includeConfig 'conf/test_metal.config' }
    test_torus { includeConfig 'conf/test_torus.config' }
    test_twas { includeConfig 'conf/test_twas.config' }
    test_finemap_extra { includeConfig 'conf/test_finemap_extra.config' }
    test_sv { includeConfig 'conf/test_sv.config' }
    test_str { includeConfig 'conf/test_str.config' }
    test_snp_indel { includeConfig 'conf/test_snp_indel.config' }
    test_eqtl { includeConfig 'conf/test_eqtl.config' }
    test_modality_sqtl { includeConfig 'conf/test_modality_sqtl.config' }
    test_pqtl { includeConfig 'conf/test_pqtl.config' }
    test_gqtl { includeConfig 'conf/test_gqtl.config' }
    test_ldsc { includeConfig 'conf/test_ldsc.config' }
    test_twas_predictdb { includeConfig 'conf/test_twas_predictdb.config' }
    test_annotate { includeConfig 'conf/test_annotate.config' }
    test_phase { includeConfig 'conf/test_phase.config' }
    test_impute { includeConfig 'conf/test_impute.config' }
    test_relate { includeConfig 'conf/test_relate.config' }
    test_vcf_prep { includeConfig 'conf/test_vcf_prep.config' }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load SiYangming/variant2qtl custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load SiYangming/variant2qtl custom profiles from different institutions.
// NOTE: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/variant2qtl.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'SiYangming/variant2qtl'
    contributors    = [
        // NOTE: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'siyangming',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/SiYangming/variant2qtl'
    description     = """An end-to-end, multi-entry Nextflow pipeline for comprehensive QTL (eQTL/sQTL/pQTL) analysis, integrating diverse genetic variants (SNPs, Indels, STRs, and SVs) with automated functional annotation."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '0.0.1dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// PLINK_RECODE aliases for GENOTYPE_TO_GWAS_FORMATS (GWAS benchmark branch)
includeConfig 'subworkflows/local/genotype_to_gwas_formats/nextflow.config'
includeConfig 'subworkflows/local/genotype_qc/nextflow.config'
includeConfig 'subworkflows/local/genotype_ingest_harmonize/nextflow.config'
includeConfig 'subworkflows/local/genotype_to_analysis_format/nextflow.config'
